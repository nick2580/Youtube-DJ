{
  "manifest_version": 3,
  "name": "yt-dj — YouTube Mix DJ",
  "version": "0.6.0",
  "description": "Turns a YouTube Mix into a DJ set: analyses the queue and blends each song into the next.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "yt-dj",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ui/core.js",
        "ui/t-neo.js",
        "ui/t-y2k.js",
        "ui/t-surreal.js",
        "ui/t-mid.js",
        "ui/t-glass.js",
        "ui/t-ethereal.js",
        "ui/t-anthro.js",
        "ui/t-pixel.js",
        "ui/t-sketch.js",
        "ui/t-japandi.js",
        "ui/t-kitsch.js",
        "ui/t-brutal.js",
        "ui/t-cyber.js",
        "ui/t-synth.js",
        "ui/t-vapor.js",
        "ui/t-pop.js",
        "ui/t-academia.js",
        "ui/t-point.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
